# Public site URL (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.seegas.com.ng

# SEEGAS's WhatsApp Business number connected to Fillo, international format, digits only.
# Every "Order on WhatsApp" link opens a chat with this number.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348081829329

# Fillo public price list (server-side only; never prefix with NEXT_PUBLIC_).
# Leave unset until Fillo ships GET /v1/public/companies/:companyId/price-list —
# the site then shows an "ask us for today's price" state instead of a price.
FILLO_API_URL=
FILLO_COMPANY_ID=
